# HealthPulse Server Environment Configuration

# Gemini API Configuration
# In production, GEMINI_API_KEY is required and failures return a safe 503 response.
# In development/test, when GEMINI_LIVE_CALLS_ENABLED is false or KEY is absent,
# clinical verification mocks are used to protect developer quotas.
GEMINI_API_KEY=
GEMINI_LIVE_CALLS_ENABLED=false

# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
UPLOAD_MAX_FILE_SIZE_MB=25
