{
  "name": "@healthpulse/server",
  "version": "1.0.0",
  "description": "HealthPulse Express backend service with Gemini API integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../shared",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test:smoke": "tsx src/smoke_test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@healthpulse/shared": "file:../shared",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
