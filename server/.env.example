# HealthPulse Server Environment Configuration

# Server Port (Render binds PORT automatically in production)
PORT=3001

# Runtime Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Google Gemini API Key
# IMPORTANT: Keep strictly server-side. Never commit or expose to frontend.
# In production on Render, set this in the Render Dashboard Environment settings.
GEMINI_API_KEY=

# Live Gemini Engine Toggle
# Set to 'true' in production to enable live model reasoning.
# When 'false' or missing key in development, uses clinical verification mock fallback.
# In production with this 'false', returns safe HTTP 503 instead of mock data.
GEMINI_LIVE_CALLS_ENABLED=false

# Client Origin for CORS
# In production, set to your Vercel deployment URL (e.g., https://healthpulse.vercel.app)
CLIENT_URL=http://localhost:5173

# Maximum File Upload Size in Megabytes
UPLOAD_MAX_FILE_SIZE_MB=25
